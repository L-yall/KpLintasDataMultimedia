# Dependency directories
node_modules/
**/node_modules/

# Production builds
frontend/build/
backend/build/
dist/
**/dist/

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
**/.env
**/.env.*
!**/.env.example

# Router encryption key and atomic creation files (never commit secrets)
/backend/config/.router-encryption.key
/backend/config/.router-encryption.key.*.tmp

# OS files
.DS_Store
Thumbs.db

# Ignore file temporary Microsoft Office
~$*.xlsx
~$*.docx